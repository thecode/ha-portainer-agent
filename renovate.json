{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": {
    "enabled": true
  },
  "gitIgnoredAuthors": ["41898282+github-actions[bot]@users.noreply.github.com"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Add-on version is the Portainer agent version",
      "managerFilePatterns": ["/^portainer_agent/config\\.json$/"],
      "matchStrings": ["\"version\": \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "portainer/agent",
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "matchDepNames": ["portainer/agent"],
      "commitMessageTopic": "Portainer agent",
      "description": "agent 3.x tags have no matching Portainer CE server release",
      "allowedVersions": "/^2\\./"
    }
  ]
}
